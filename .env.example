# Destinatário das denúncias
DENUNCIA_EMAIL_TO=cdmjiujitsu@gmail.com

# Remetente exibido no e-mail recebido.
# Com Resend, use um endereço de domínio verificado (ex.: canal@cdmjj.org.br).
# Com SMTP do Gmail, use a própria conta: "CDMJJ" <cdmjiujitsu@gmail.com>
DENUNCIA_EMAIL_FROM="CDMJJ - Canal de Denúncias" <cdmjiujitsu@gmail.com>

# Contato público e redes sociais
NEXT_PUBLIC_CONTACT_EMAIL=cdmjiujitsu@gmail.com
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/cdmjj/
NEXT_PUBLIC_SITE_URL=https://www.cdmjj.org.br

# Opção 1 — Resend
# RESEND_API_KEY=

# Opção 2 — SMTP (no Gmail, use uma senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=cdmjiujitsu@gmail.com
SMTP_PASS=

# Segredo usado para anonimizar IPs no limite de tentativas.
# Gere uma frase longa e aleatória em produção.
RATE_LIMIT_SALT=
